# ──────────────────────────────────────────────────────────────────────────
# Sonora · variables de entorno
#
# Copia este archivo a `.env` para desarrollo local o configúralas en el
# panel de Vercel/Netlify (frontend) y Render/Railway/Fly (API).
# ──────────────────────────────────────────────────────────────────────────

# URL pública del API. La web y la APK la usan para pedir catálogo,
# categorías, búsqueda, historial y eventos SSE.
# En local se puede dejar vacía: las peticiones van a rutas relativas.
VITE_API_BASE_URL=https://sonora-api.onrender.com

# URL pública de la web que carga la APK (Vercel/Netlify).
# Se escribe en capacitor.config.json → server.url antes de `cap sync`.
# Con esto, cada cambio publicado se ve en la APK sin reinstalarla.
SONORA_APP_URL=https://sonora.vercel.app
